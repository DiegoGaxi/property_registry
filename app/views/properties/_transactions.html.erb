<% txs = property.property_transactions.recent %>
<div id="transactions_<%= property.id %>" class="tx-list" data-controller="transactions-poll" data-transactions-poll-property-id-value="<%= property.id %>">
  <% if txs.empty? %>
    <p class="tx-empty">Sin transacciones registradas aún.</p>
  <% else %>
  <table class="tx-table modern compact">
      <thead>
        <tr>
          <th>Acción</th>
          <th>Tx</th>
        </tr>
      </thead>
      <tbody>
        <% txs.each do |t| %>
          <tr class="tx-row">
            <td><%= t.action %></td>
            <td class="mono" title="<%= t.tx_hash %>"><%= t.short_hash %>
              <button type="button" class="copy-btn" data-tx="<%= t.tx_hash %>" onclick="navigator.clipboard.writeText('<%= t.tx_hash %>')">Copiar</button>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
